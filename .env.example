# --- Database ---
# Local dev uses docker-compose (see README). Neon connection string on production.
DATABASE_URL="postgresql://faktury:faktury@localhost:5432/faktury?schema=public"

# --- Auth.js ---
# Generate: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Base URL of the app. Auth.js infers this on Vercel, set explicitly for local.
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
