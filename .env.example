# --- Database ---
# Local dev: `npm run db:up` starts a local Postgres via Prisma (`prisma dev`).
# It prints connection URLs; if the ports below differ, run `npx prisma dev ls`
# and update them. Production: a Neon connection string (postgresql://...).
DATABASE_URL="postgres://postgres:postgres@localhost:51222/faktury?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51223/faktury?sslmode=disable"

# --- Auth.js ---
# Generate: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- App ---
# Used to build absolute URLs (Stripe redirects, e-mail links). Falls back to AUTH_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (test mode) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# or the dashboard webhook endpoint signing secret.
STRIPE_WEBHOOK_SECRET=""

# --- Resend (transactional e-mail) ---
# https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender. Use "onboarding@resend.dev" for local testing.
EMAIL_FROM="Faktury <onboarding@resend.dev>"
